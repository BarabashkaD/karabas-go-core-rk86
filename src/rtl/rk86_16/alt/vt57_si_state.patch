 reg [7:0] d = 8'h00;
 reg [3:0] drq = 4'd0;
-reg hold_s = 1'b0, hlda = 1'b0, hlda_off = 1'b0;
+reg hold_s = 1'b0, hlda = 1'b0, hlda_off = 1'b0, hlda_on = 1'b0;
 wire [7:0] d_o;
 wire [3:0] dack_n;
 wire [15:0] a_o;
@@ -32,10 +32,11 @@ k580vt57 dut(.clk(clk), .th_up(f2), .th_dn(f2_fall), .reset(reset), .cs_n(cs_n),
     .a_i(a), .d_i(d), .d_o(d_o), .drq(drq), .hlda(hlda), .ready(ready), .hrq(hrq), .dack_n(dack_n),
     .a_o(a_o), .aen(aen), .adstb(adstb), .memr_n(memr_n), .memw_n(memw_n), .ior_n_o(ior_n_o), .iow_n_o(iow_n_o),
     .tc(tc), .mark(mark));
-// the 8080 of tb_vt57.v: HOLD sampled at Φ2↑, HLDA at the next Φ1↑; hlda_off holds HLDA low (DMA-15, DMA-16)
+// the 8080 of tb_vt57.v: HOLD sampled at Φ2↑, HLDA at the next Φ1↑; hlda_off holds HLDA low (DMA-15, DMA-16),
+// hlda_on holds it high (check 20)
 always @(posedge clk) begin
     if (f2) hold_s <= hrq;
-    if (f1) hlda <= hold_s && !hlda_off;
+    if (f1) hlda <= (hold_s || hlda_on) && !hlda_off;
 end
 // the requesters: rmode[c] 0 held, 1 per strobe; ctype[c] the cycle type programmed for channel c
 // (count bits 15:14); left[c] the transfers still to request
@@ -79,9 +80,12 @@ reg adstb_q = 1'b0;
 // HRQ, A15-A0}
 localparam HB = 18;
 reg [31:0] hist [0:(1 << HB) - 1];
-integer quiet = 0, holds = 0, hrq_up = -1000, hlda_up = -1000, rdy_hi = -1, rdy_t0 = 0;
-reg hrq_q = 1'b0, hlda_q = 1'b0;
+integer quiet = 0, holds = 0, hrq_up = -1000, hlda_up = -1000, rdy_hi = -1, rdy_t0 = 0, samp0 = -1000;
+reg hrq_q = 1'b0, hlda_q = 1'b0, drq0_seen = 1'b0;
 always @(posedge clk) if (ce16) begin
+    // check 20: the DRQ sample, the first θ↓ that sees DRQ0 high after it rose (as tb_vt57's latency anchor)
+    if (!drq[0]) drq0_seen = 1'b0;
+    if (f2_fall && drq[0] && !drq0_seen) begin samp0 = n16; drq0_seen = 1'b1; end
     if (adstb && !adstb_q) s1 = n16 - 5;
     rel = n16 - s1 - 1;
     if (rel == 10) begin
@@ -696,6 +700,31 @@ initial begin
     wait_idle;
     run_ch(2, 0, 1'b1);
 
+    // 20. M9 (review 2026-11-11): the state after the DRQ sample is SI with HRQ set, S0 one θ↓ later ([C78] 12-104
+    // Fig. 6 note 1 "HRQ is set if DRQn is active", the SI → S0 arc on HRQ; 12-110: SI, SI with HRQ↑, S0, S1). With
+    // HLDA already high: HRQ↑ 4 ce16 after the DRQ sample, S0 at + 9, the first HLDA sample at its end, S1 (AEN↑) at
+    // + 18, not at + 9
+    part("si hrq", "M9, [C78] 12-104 Fig. 6 note 1, 12-110");
+    mode_set(8'h01);
+    prog(0, 16'h1A00, 16'h4000);
+    @(negedge clk) hlda_on = 1'b1;
+    `WAIT_B(w20a, hlda, 100)
+    @(negedge clk) t = n16;
+    request(0, 1, 1'b0);
+    wait_idle;
+    @(negedge clk) hlda_on = 1'b0;
+    `WAIT_B(w20b, !hlda, 100)
+    run_ch(1, 0, 1'b0);
+    if (ntr - ntr0 == 1 && samp0 > t) begin
+        if (hrq_up - samp0 != 4) begin
+            $sformat(dmsg, "HRQ %0d after the DRQ sample, expected 4", hrq_up - samp0); ck(1'b0, dmsg);
+        end
+        if (s1_of[ntr0] - samp0 != 18) begin
+            $sformat(dmsg, "AEN (S1) %0d after the DRQ sample, expected 18 (SI, S0, S1)", s1_of[ntr0] - samp0);
+            ck(1'b0, dmsg);
+        end
+    end else ck(1'b0, "no DRQ0 sample or no transfer");
+
     if (errors == 0) $display("PASS: vt57f (%0d transfers)", ntr);
     $finish;
 end
