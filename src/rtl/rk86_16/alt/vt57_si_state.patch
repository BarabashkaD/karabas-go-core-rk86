diff --git a/src/rtl/rk86_16/k580vt57.v b/src/rtl/rk86_16/k580vt57.v
index 1df2e12..7fa3846 100644
--- a/src/rtl/rk86_16/k580vt57.v
+++ b/src/rtl/rk86_16/k580vt57.v
@@ -20,6 +20,10 @@
 //   - at the θ↓ that starts S4: DRQ and HLDA → S1 after S4; otherwise (no DRQ, or HLDA lost) HRQ↓ at
 //     θ↑(S4) and SI after S4 (Fig. 6); with DRQ still active SI → S0 raises HRQ again ([C78] 12-105,
 //     12-110 "control override sequence")
+//   - SI → S0 (review 2026-11-11, M9): the θ↓ that sees a DRQ keeps the 8257 in SI and HRQ rises at the next θ↑;
+//     S0 follows at the next θ↓ ([C78] 12-104 Fig. 6 note 1 "HRQ is set if DRQn is active", the SI → S0 arc
+//     on HRQ; the 12-110 waveform: SI, SI with HRQ↑, S0, S1), so the first HLDA sample is 18 ce16 after the
+//     DRQ sample
 //   - verify / write / read cycles; extended write (mode bit 5): MEMW / IOW from θ↑(S2)
 //   - READY sampled at θ↑ of S3 and SW: wait states SW (not in verify cycles)
 //   - four channels, fixed or rotating priority, TC stop, autoload with the update flag (set with TC↑,
@@ -55,6 +59,7 @@ module k580vt57(
 );
 localparam [2:0] SI = 3'd0, S0 = 3'd1, S1 = 3'd2, S2 = 3'd3, S3 = 3'd4, SW = 3'd5, S4 = 3'd6;
 reg  [2:0] state = SI;
+reg        req = 1'b0;             // in SI: a DRQ seen at the last θ↓ (HRQ set in SI, Fig. 6 note 1)
 reg  [7:0] mode = 8'h00;           // AL TCS EW RP EN3 EN2 EN1 EN0
 reg [15:0] ad [0:3];               // DMA address registers
 reg [15:0] tr [0:3];               // terminal count registers: 15:14 the cycle, 13:0 N - 1
@@ -150,7 +155,7 @@ always @(posedge clk) begin
         //---------------- θ↓: the states, DACK, AEN↑, IOR↑ / MEMR↑, the DRQ / HLDA / READY decisions
         if (th_dn) begin
             case (state)
-                SI: if (p[2]) state <= S0;                                // DMA-16: pin-equivalent label
+                SI: if (req) state <= S0;                                 // Fig. 6 note 1: one θ↓ after the sample
                 S0: if (!p[2]) state <= SI;                               // SILENT: DMA-16
                     else if (hlda) begin
                         state <= S1; ch <= p[1:0]; aen <= 1'b1;
@@ -195,6 +200,7 @@ always @(posedge clk) begin
             if (state == S3 && tc_now) tcs[ch] <= 1'b1;
             if (state == S3 && tc_now && mode[7] && ch == 2'd2) begin upd <= 1'b1; reload <= 1'b1; end  // with TC↑ (DMA-24)
             if (state == S3 || state == SW) rdy <= ready;
+            if (state == SI && req) hrq <= 1'b1;                                      // Fig. 6 note 1: HRQ set in SI
         end
         if (upd_now) begin
             done <= 1'b0;
@@ -208,5 +214,10 @@ always @(posedge clk) begin
         end
     end
 end
+// the DRQ sample of SI ([C78] 12-104 Fig. 6 note 1, 12-109 TQS): set at a θ↓ in SI that sees a request, so SI → S0 one
+// θ↓ later; cleared at every other θ↓ (S0 → SI with no DRQ, S4 → SI: the next SI samples again)
+always @(posedge clk)
+    if (reset) req <= 1'b0;
+    else if (th_dn) req <= state == SI && p[2];
 endmodule
 `default_nettype wire
